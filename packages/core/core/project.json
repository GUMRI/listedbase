{
  "name": "listedbase",
  "projectType": "library",
  "tags": ["platform:isomorphic", "scope:core"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p packages/core/core/tsconfig.json" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p packages/core/core/tsconfig.json --noEmit" }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
