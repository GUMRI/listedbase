{
  "name": "drivers-firestore",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/drivers/firestore/src",
  "tags": ["scope:driver", "env:browser"],
  "implicitDependencies": ["drivers-abstract"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/drivers/firestore",
        "main": "packages/drivers/firestore/src/index.ts",
        "tsConfig": "packages/drivers/firestore/tsconfig.lib.json",
        "assets": ["packages/drivers/firestore/*.md"]
      }
    }
  }
}
