{
  "name": "drivers-sqlite",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/drivers/sqlite/src",
  "tags": ["scope:driver", "env:node"],
  "implicitDependencies": ["drivers-abstract"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/drivers/sqlite",
        "main": "packages/drivers/sqlite/src/index.ts",
        "tsConfig": "packages/drivers/sqlite/tsconfig.lib.json",
        "assets": ["packages/drivers/sqlite/*.md"]
      }
    }
  }
}
