        "outputPath": "dist/packages/consumers/express",
        "main": "packages/consumers/express/src/index.ts",
        "tsConfig": "packages/consumers/express/tsconfig.lib.json",
        "assets": ["packages/consumers/express/*.md"]
      }
    }
  }
