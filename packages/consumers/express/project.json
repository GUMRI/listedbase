{
  "name": "consumers-express",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/consumers/express/src",
  "tags": ["scope:consumer", "env:node"],
  "implicitDependencies": ["consumers-abstract"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
